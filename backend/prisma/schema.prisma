generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  FARMER
  ADMIN
}

model User {
  id             String       @id @default(uuid())
  name           String       @db.VarChar(100)
  email          String?      @unique @db.VarChar(255)
  password       String       @db.VarChar(255)
  role           Role         @default(FARMER)
  region         String   ?    @db.VarChar(100)
  city           String?      @db.VarChar(100)
  phone          String       @unique @db.VarChar(20)
  profilePicture String?      @db.VarChar(255)
  bio            String?      @db.Text
  address        String?      @db.VarChar(255)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  records        CropRecord[]

  @@index([email])
  @@index([phone])
  @@index([region])
}

model CropRecord {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  cropType       String    @db.VarChar(50)
  plantingDate   DateTime
  harvestingDate DateTime?
  notes          String?   @db.Text
  expenses       Expense[]
  yields         Yield[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
  @@index([cropType])
  @@index([plantingDate])
}

model Expense {
  id           String     @id @default(uuid())
  cropRecordId String
  cropRecord   CropRecord @relation(fields: [cropRecordId], references: [id], onDelete: Cascade)
  item         String     @db.VarChar(100)
  cost         Float      @db.DoublePrecision
  date         DateTime
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([cropRecordId])
  @@index([date])
}

model Yield {
  id           String     @id @default(uuid())
  cropRecordId String
  cropRecord   CropRecord @relation(fields: [cropRecordId], references: [id], onDelete: Cascade)
  quantity     Float      @db.DoublePrecision
  unit         String     @db.VarChar(20)
  date         DateTime
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([cropRecordId])
  @@index([date])
}

model MarketPrice {
  id        String   @id @default(uuid())
  crop      String   @db.VarChar(50)
  region    String   @db.VarChar(100)
  price     Float    @db.DoublePrecision
  unit      String   @db.VarChar(20)
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([crop, region, date])
  @@index([crop])
  @@index([region])
  @@index([date])
}

model FarmingTip {
  id        String   @id @default(uuid())
  tip       String   @db.Text
  crop      String?  @db.VarChar(50)
  region    String?  @db.VarChar(100)
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([crop])
  @@index([region])
  @@index([date])
}

model Weather {
  id        String   @id @default(uuid())
  region    String   @db.VarChar(100)
  data      Json
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([region, date])
  @@index([region])
  @@index([date])
}
